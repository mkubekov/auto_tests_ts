{
  "name": "auto-tests-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript/Playwright learning port of the cms-autotests Python test-automation project",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "playwright test --project=unit",
    "test:list": "playwright test --project=api --project=cms --project=ui --list"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
