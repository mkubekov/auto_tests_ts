{
  "name": "auto-tests-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Registry-driven API, admin-panel and public-site tests for a content CMS: a TypeScript/Playwright Test port of the cms-autotests Python project",
  "keywords": [
    "playwright",
    "playwright-test",
    "typescript",
    "test-automation",
    "e2e",
    "api-testing",
    "page-object-model",
    "zod",
    "faker",
    "cms"
  ],
  "homepage": "https://github.com/mkubekov/auto_tests_ts#readme",
  "bugs": {
    "url": "https://github.com/mkubekov/auto_tests_ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkubekov/auto_tests_ts.git"
  },
  "license": "MIT",
  "author": "Murat Kubekov <mkubekov@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "playwright test --project=unit",
    "test:list": "playwright test --project=api --project=cms --project=ui --list"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  }
}
