# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# Content API root (entity endpoints are appended to it).
API_BASE_URL=https://api.example.com/api/v3
# Admin panel root; forms are opened at <CMS_BASE_URL>/<cms_path>.
CMS_BASE_URL=https://cms.example.com
# Admin auth API (login/logout). Defaults to <CMS_BASE_URL>/api/v1 when unset.
# CMS_API_BASE_URL=https://cms.example.com/api/v1
# Public site root. UI tests are skipped when unset.
# SITE_BASE_URL=https://www.example.com

API_KEY=replace-me
CMS_EMAIL=qa@example.com
CMS_PASSWORD=replace-me

# Public page that renders the page template created by UI tests.
TEST_PAGE_PATH=/autotest
VIEWPORT=1920x1080
# ws:// endpoint of a remote Playwright server or grid. Unset = local browser.
# REMOTE_BROWSER_WS=ws://playwright-grid.example.com/
# Browser for the cms/ui suites: chromium (default), firefox or webkit. Read by
# playwright.config.ts from the shell environment only — setting it here has no effect.
# BROWSER=firefox
# BROWSER_TIMEOUT_MS=240000
# CONNECT_TIMEOUT_S=10
# READ_TIMEOUT_S=60

# Faker locale for generated data and a fixed seed to replay a run (printed in every report).
# FAKER_LOCALE=en_US
# FAKER_SEED=
# Endpoint that finds entities by name across modules; unset disables the end-of-run sweep.
# GLOBAL_SEARCH_PATH=content/global-search
